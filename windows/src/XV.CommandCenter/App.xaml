<Application x:Class="XV.CommandCenter.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Palette taken from the reference PC Command Center (Tailwind zinc / emerald / amber / cyan / violet / rose) -->
        <SolidColorBrush x:Key="Bg" Color="#09090B"/>
        <SolidColorBrush x:Key="Panel" Color="#101012"/>
        <SolidColorBrush x:Key="Card" Color="#18181B"/>
        <SolidColorBrush x:Key="CardHover" Color="#1F1F23"/>
        <SolidColorBrush x:Key="Line" Color="#27272A"/>
        <SolidColorBrush x:Key="Line2" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Text" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="Text2" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="Muted" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="Dim" Color="#71717A"/>
        <SolidColorBrush x:Key="Emerald" Color="#34D399"/>
        <SolidColorBrush x:Key="Emerald6" Color="#059669"/>
        <SolidColorBrush x:Key="EmeraldBg" Color="#0D2A20"/>
        <SolidColorBrush x:Key="Amber" Color="#FBBF24"/>
        <SolidColorBrush x:Key="Amber5" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AmberBg" Color="#2A1F08"/>
        <SolidColorBrush x:Key="Cyan" Color="#22D3EE"/>
        <SolidColorBrush x:Key="Violet" Color="#C084FC"/>
        <SolidColorBrush x:Key="Rose" Color="#FB7185"/>
        <SolidColorBrush x:Key="RoseBg" Color="#2A0F14"/>
        <SolidColorBrush x:Key="Blue" Color="#60A5FA"/>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>

        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="{StaticResource Sans}"/></Style>
        <Style x:Key="MonoText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Mono}"/><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/></Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontSize" Value="12.5"/><Setter Property="Foreground" Value="{StaticResource Text2}"/></Style>

        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="14"/>
        </Style>

        <!-- Buttons -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="{StaticResource Sans}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
        <Style x:Key="BtnAmber" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#F59E0B"/><Setter Property="Foreground" Value="#18181B"/><Setter Property="BorderBrush" Value="#FBBF24"/><Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="BtnEmerald" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#062F23"/><Setter Property="Foreground" Value="#6EE7B7"/><Setter Property="BorderBrush" Value="#047857"/>
        </Style>
        <Style x:Key="BtnGold" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2A1F08"/><Setter Property="Foreground" Value="#FCD34D"/><Setter Property="BorderBrush" Value="#92400E"/>
        </Style>
        <Style x:Key="BtnBlue" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#0B1B33"/><Setter Property="Foreground" Value="#93C5FD"/><Setter Property="BorderBrush" Value="#1D4ED8"/>
        </Style>
        <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#2A0F14"/><Setter Property="Foreground" Value="#FDA4AF"/><Setter Property="BorderBrush" Value="#9F1239"/>
        </Style>
        <Style x:Key="BtnSmall" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Padding" Value="8,3"/><Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- Tab pills -->
        <Style x:Key="TabPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="12,7" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#27272A"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0C0C0E"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9,6"/><Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A1A1AA"/></Trigger>
                            <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="b" Property="Background" Value="#141417"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0C0C0E"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12.5"/><Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Style.Resources>
                <!-- The app-wide white TextBlock style must not apply inside the light drop-down box and its list. -->
                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#18181B"/></Style>
                <!-- Editable drop-downs: their text box must not take the app's dark text-box style (white text on the light box). -->
                <Style TargetType="TextBox">
                    <Setter Property="Foreground" Value="#18181B"/><Setter Property="Background" Value="Transparent"/><Setter Property="CaretBrush" Value="#18181B"/>
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost"/></ControlTemplate></Setter.Value></Setter>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#18181B"/></Style>
        <Style TargetType="DatePicker"><Setter Property="Foreground" Value="#18181B"/></Style>
        <Style TargetType="ToolTip"><Setter Property="Background" Value="#27272A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#3F3F46"/></Style>
        <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    </Application.Resources>
</Application>
