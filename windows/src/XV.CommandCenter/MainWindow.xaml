<Window x:Class="XV.CommandCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XV Digital Access Control — HQ Central Command" Width="1600" Height="980" MinWidth="1180" MinHeight="700"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico">
    <DockPanel>
        <!-- ============ Header bar ============ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="#F59E0B">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#18181B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HQ CENTRAL COMMAND" FontWeight="Bold" FontSize="15"/>
                            <Border x:Name="ServerBadge" Margin="10,0,0,0" CornerRadius="10" Padding="8,2" Background="#0D2A20" BorderBrush="#047857" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ServerDot" Width="6" Height="6" Fill="{StaticResource Emerald}" Margin="0,0,5,0"/>
                                    <TextBlock x:Name="ServerBadgeText" Text="PC SERVER ACTIVE" Style="{StaticResource MonoText}" Foreground="{StaticResource Emerald}" FontWeight="Bold" FontSize="10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Style="{StaticResource MonoText}" Margin="0,3,0,0" Text="XV DIGITAL ACCESS CONTROL  Multi-Gate Telemetry • Encrypted Local Server (TLS + AES-256-GCM)"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource CardBox}" Padding="12,6" Margin="0,0,8,0" CornerRadius="8" Background="#0C0C0E">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MonoText}" Text="Server:" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HdrEndpoint" Style="{StaticResource MonoText}" Foreground="{StaticResource Emerald}" FontWeight="Bold" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource MonoText}" Text="|  DB:" VerticalAlignment="Center"/>
                            <TextBlock Style="{StaticResource MonoText}" Foreground="{StaticResource Amber}" FontWeight="Bold" Margin="6,0,0,0" Text="SQLCipher Encrypted" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource BtnAmber}" Margin="0,0,6,0" Click="AddSoldier_Click" Content="+ Add Soldier"/>
                    <Button Style="{StaticResource BtnAmber}" Margin="0,0,6,0" Click="AddVehicle_Click" Content="+ Add Vehicle"/>
                    <Button Style="{StaticResource BtnEmerald}" Margin="0,0,6,0" Click="ImportExport_Click" Content="Import / Export"/>
                    <Button Style="{StaticResource BtnGold}" Margin="0,0,6,0" Click="Pair_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Local Wi-Fi &amp; Pair Device" Foreground="#FCD34D" FontWeight="SemiBold"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource Emerald}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource BtnBlue}" Margin="0,0,6,0" Click="Cloud_Click" Content="Cloud Link"/>
                    <Button Margin="0,0,6,0" Click="Stations_Click" Content="Stations &amp; Settings"/>
                    <Button Click="Refresh_Click" ToolTip="Refresh now" Padding="10,7">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Status bar ============ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,5">
            <DockPanel>
                <TextBlock x:Name="StatusLeft" Style="{StaticResource MonoText}" DockPanel.Dock="Left"/>
                <TextBlock x:Name="StatusRight" Style="{StaticResource MonoText}" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Left telemetry sidebar ============ -->
            <Border Background="#0B0B0D" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer Padding="20,18,16,18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Amber}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="BASE PRESENCE TELEMETRY"/>
                            <TextBlock Style="{StaticResource MonoText}" Text="Live Sync" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <UniformGrid Columns="2" Rows="2">
                            <Border Style="{StaticResource CardBox}" Margin="0,0,5,10" Cursor="Hand" MouseLeftButtonUp="StatInside_Click">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Inside Facility" Foreground="{StaticResource Text2}" FontSize="12"/><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Emerald}" HorizontalAlignment="Right"/></DockPanel>
                                    <TextBlock x:Name="StatInside" Text="0" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Emerald}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatInsideSub" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" Margin="5,0,0,10" Cursor="Hand" MouseLeftButtonUp="StatFleet_Click">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Fleet On-Base" Foreground="{StaticResource Text2}" FontSize="12"/><TextBlock Text="&#xE806;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" HorizontalAlignment="Right"/></DockPanel>
                                    <TextBlock x:Name="StatFleet" Text="0" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Cyan}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatFleetSub" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonUp="StatFlags_Click">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Location Flags" Foreground="{StaticResource Text2}" FontSize="12"/><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Amber}" HorizontalAlignment="Right"/></DockPanel>
                                    <TextBlock x:Name="StatFlags" Text="0" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Amber}" Margin="0,6,0,4"/>
                                    <TextBlock Text="Cross-location alerts recorded" FontSize="10.5" Foreground="#D97706"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBox}" Margin="5,0,0,0">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Total Events" Foreground="{StaticResource Text2}" FontSize="12"/><TextBlock Text="&#xE83D;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Violet}" HorizontalAlignment="Right"/></DockPanel>
                                    <TextBlock x:Name="StatTotal" Text="0" FontFamily="{StaticResource Mono}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource Violet}" Margin="0,6,0,4"/>
                                    <TextBlock x:Name="StatTotalSub" Style="{StaticResource MonoText}" FontSize="10" Text="Server ACK Verified"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <DockPanel Margin="0,24,0,10">
                            <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="GATE STATION NETWORK"/>
                            <TextBlock x:Name="GateOnline" Style="{StaticResource MonoText}" Foreground="{StaticResource Emerald}" FontWeight="Bold" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <StackPanel x:Name="GateList"/>

                        <DockPanel Margin="0,24,0,10">
                            <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Violet}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="PAIRED TERMINALS"/>
                            <TextBlock x:Name="DeviceCount" Style="{StaticResource MonoText}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <StackPanel x:Name="DeviceList"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============ Main area ============ -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="#111113" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabFeed" Style="{StaticResource TabPill}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabPersons" Style="{StaticResource TabPill}" GroupName="tabs" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabVehicles" Style="{StaticResource TabPill}" GroupName="tabs" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabAccounts" Style="{StaticResource TabPill}" GroupName="tabs" Checked="Tab_Checked"/>
                                <RadioButton x:Name="TabAudit" Style="{StaticResource TabPill}" GroupName="tabs" Checked="Tab_Checked" Content="Audit Trail"/>
                            </StackPanel>
                        </Border>
                        <Grid HorizontalAlignment="Right" Width="330">
                            <TextBox x:Name="Search" TextChanged="Search_Changed" Padding="30,7,9,7" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Dim}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SearchHint" Text="Filter by ID, Name, Location..." Foreground="{StaticResource Dim}" FontFamily="{StaticResource Mono}" FontSize="12" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="MainScroll" Padding="24,18">
                    <StackPanel>
                        <DockPanel x:Name="SectionHeader" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SectionTitle" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Text2}"/>
                                    <Border x:Name="SectionCountBorder" Margin="10,0,0,0" CornerRadius="10" Padding="8,1" Background="#2A1F08" BorderBrush="#92400E" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="SectionCount" Style="{StaticResource MonoText}" Foreground="{StaticResource Amber}" FontWeight="Bold" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="SectionSub" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel x:Name="SectionActions" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                        <WrapPanel x:Name="FilterChips" Margin="0,0,0,12"/>
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,0,0,14"/>
                        <ContentControl x:Name="ContentHost"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
