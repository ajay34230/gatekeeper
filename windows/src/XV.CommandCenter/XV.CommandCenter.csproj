<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XVCommandCenter</AssemblyName>
    <RootNamespace>XV.CommandCenter</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>XV Digital Access Control</Product>
    <Company>XV Digital Access Control</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\XV.Core\XV.Core.csproj" /><ProjectReference Include="..\XV.Comms\XV.Comms.csproj" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
